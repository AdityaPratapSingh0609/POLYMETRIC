# SQLite database file (local development). For Docker, this is overridden in docker-compose.yml.
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-this-with-a-long-random-string"

# Set to "production" when deploying (Docker sets this automatically).
NODE_ENV="development"
